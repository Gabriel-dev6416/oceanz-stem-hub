# Copy to .env and replace every change-me value. Never commit .env.

# config.settings.development locally; config.settings.production on Render.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Private path for the Django admin (Super Admin only). Do not use "admin".
DJANGO_ADMIN_URL=change-me

# Production-only switches (ignored by development settings).
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_COOKIES=True

POSTGRES_DB=oceanz
POSTGRES_USER=oceanz
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
REDIS_PORT=6379
WEB_PORT=8000

# Used when running manage.py or pytest on the host against the compose services.
# docker compose overrides both with the internal service addresses.
DATABASE_URL=postgres://oceanz:change-me@127.0.0.1:5432/oceanz
REDIS_URL=redis://127.0.0.1:6379/0

# Docker Hub repository, e.g. yourname/oceanz-stem-hub
DOCKER_IMAGE=oceanz-stem-hub
IMAGE_TAG=latest
